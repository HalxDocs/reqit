{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "Windows: ./build/bin/reqit.exe | Linux: ./build/bin/reqit",
  "mcp": {
    "reqit": {
      "type": "local",
      "command": ["./build/bin/reqit", "mcp"],
      "enabled": true
    },
    "reqit-http": {
      "type": "remote",
      "url": "http://127.0.0.1:7247/mcp",
      "enabled": false
    }
  }
}
