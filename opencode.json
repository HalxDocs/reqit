{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "Windows: C:/.../reqit.exe | Linux (Fedora): ./flux/build/bin/reqit — build with `go build -o flux/build/bin/reqit .`",
  "mcp": {
    "reqit": {
      "type": "local",
      "command": ["./flux/build/bin/reqit", "mcp"],
      "enabled": true
    },
    "reqit-http": {
      "type": "remote",
      "url": "http://127.0.0.1:7247/mcp",
      "enabled": false
    }
  }
}
